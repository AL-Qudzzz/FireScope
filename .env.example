# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIRMS_MAP_KEY: Optional NASA FIRMS Area API key (server-side only; never commit real keys).
# When omitted, FireScope operates with its checksummed NASA FIRMS archive fixtures in explicit Demo/Snapshot Mode.
FIRMS_MAP_KEY="YOUR_NASA_FIRMS_MAP_KEY_HERE"

# PORT: HTTP listen port (defaults to 3000).
PORT="3000"

# CORS_ALLOWED_ORIGIN: Optional single allowed cross-origin frontend URL (same-origin by default when omitted).
CORS_ALLOWED_ORIGIN=""

